<script>
    let scores = { human: 0, ai: 0, ties: 0 };
    let prevOutcome = null;
    let timeLeft = 10;
    let timerInterval = null;
    let isGameOver = false;
    let isPaused = false; 
    let roundsPlayed = 0;

    startTimer();
    updateTelemetryDefaults();

    function startTimer() {
        if(isGameOver || isPaused) return; 
        clearInterval(timerInterval);
        timeLeft = 10;
        document.getElementById("timer").innerText = timeLeft + "s";
        document.getElementById("timer").style.color = "#ffea00";
        document.getElementById("timer").style.textShadow = "0 0 10px #ffea00";

        timerInterval = setInterval(() => {
            if (isPaused) return; 

            timeLeft--;
            document.getElementById("timer").innerText = timeLeft + "s";

            if(!isPaused && !isGameOver) {
                document.getElementById("status-astar").innerText = "f(n) = " + (10 - timeLeft) + " + " + timeLeft + " (Optimal)";
            }

            if (timeLeft <= 3) {
                document.getElementById("timer").style.color = "#ff0055";
                document.getElementById("timer").style.textShadow = "0 0 10px #ff0055";
            }

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                handleTimeout();
            }
        }, 1000);
    }

    function togglePause() {
        if (isGameOver) return;
        const pauseBtn = document.getElementById("btn-pause");
        const gameButtons = document.getElementsByClassName("game-btn");

        if (!isPaused) {
            isPaused = true;
            clearInterval(timerInterval);
            pauseBtn.innerText = "▶️ Resume";
            pauseBtn.classList.add("paused");
            
            for(let btn of gameButtons) { btn.disabled = true; }
            document.getElementById("choices").innerHTML = '<span style="color:#ffea00">GAME PAUSED</span>';
            
            document.getElementById("status-minimax").innerText = "Pruning suspended";
            document.getElementById("status-bfs").innerText = "Priority Queue frozen";
            document.getElementById("status-chaining").innerText = "Inference on hold";
        } else {
            isPaused = false;
            pauseBtn.innerText = "⏸️ Pause";
            pauseBtn.classList.remove("paused");
            
            for(let btn of gameButtons) { btn.disabled = false; }
            document.getElementById("choices").innerText = "Awaiting your move...";
            startTimer();
        }
    }

    function handleTimeout() {
        scores.ai++;
        roundsPlayed++; 
        prevOutcome = "loss";
        
        document.getElementById("choices").innerHTML = '<span style="color:#ff0055">CONNECTION TIMEOUT: You took too long!</span>';
        
        const resultElement = document.getElementById("result");
        resultElement.innerText = "AI WINS BY DEFAULT! 🤖⚡";
        resultElement.style.color = "#ff0055";
        resultElement.style.textShadow = "0 0 10px #ff0055";
        document.getElementById("status-chaining").innerText = "Forward: Timeout -> AI Point";

        updateScoreboard();
        
        if (!checkMatchWinner()) {
            setTimeout(() => {
                if (timeLeft <= 0 && !isGameOver && !isPaused) { 
                    startTimer();
                }
            }, 2000);
        }
    }

    async function playRound(humanMove) {
        if(isGameOver || isPaused) return;

        document.getElementById("status-chaining").innerText = "Backward: Goal=Win -> Check History";

        try {
            const response = await fetch('/api/predict', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ humanMove: humanMove, prevOutcome: prevOutcome })
            });
            
            const data = await response.json();
            const aiMove = data.aiMove;

            document.getElementById("status-bfs").innerText = data.telemetry.bfs;
            document.getElementById("status-minimax").innerText = "Max: " + capitalize(aiMove) + " | Min: " + capitalize(humanMove);

            let outcome;
            let resultText;
            let resultColor;

            if (humanMove === aiMove) {
                outcome = "tie";
                resultText = "TIE DETECTED 🤝";
                resultColor = "#ffb300";
                scores.ties++;
            } else if (
                (humanMove === "rock" && aiMove === "scissors") ||
                (humanMove === "paper" && aiMove === "rock") ||
                (humanMove === "scissors" && aiMove === "paper")
            ) {
                outcome = "win";
                resultText = "YOU BREACHED THE AI! 🎉";
                resultColor = "#00ff66";
                scores.human++;
            } else {
                outcome = "loss";
                resultText = "AI OUTSMARTED YOU! 🤖⚡";
                resultColor = "#ff0055";
                scores.ai++;
            }

            roundsPlayed++;
            prevOutcome = outcome;

            document.getElementById("status-chaining").innerText = "Forward: Fact Base -> " + capitalize(outcome);
            document.getElementById("choices").innerHTML = "You chose: <span style='color:#fff'>" + capitalize(humanMove) + "</span> | AI chose: <span style='color:#fff'>" + capitalize(aiMove) + "</span>";
            
            const resultElement = document.getElementById("result");
            resultElement.innerText = resultText;
            resultElement.style.color = resultColor;
            resultElement.style.textShadow = "0 0 10px " + resultColor;

            updateScoreboard();
            const hasEnded = checkMatchWinner();
            if (!hasEnded) startTimer();

        } catch (error) {
            console.error("Communication failure with predictive logic framework:", error);
        }
    }

    function updateScoreboard() {
        document.getElementById("score-human").innerText = scores.human;
        document.getElementById("score-ai").innerText = scores.ai;
        document.getElementById("score-ties").innerText = scores.ties;
        
        let displayRound = roundsPlayed + 1;
        if (displayRound > 5) displayRound = 5;
        document.getElementById("round-tracker").innerText = "ROUND: " + displayRound + " / 5";
    }

    function updateTelemetryDefaults() {
        document.getElementById("status-astar").innerText = "f(n) = Cost + Heuristic";
        document.getElementById("status-minimax").innerText = "Awaiting Alpha-Beta depth...";
        document.getElementById("status-bfs").innerText = "Best node selection ready";
        document.getElementById("status-chaining").innerText = "Rule inference parser ready";
    }

    function checkMatchWinner() {
        let matchEnded = false;
        let finalWinner = "";

        if (scores.human === 3) {
            matchEnded = true;
            finalWinner = "human";
        } else if (scores.ai === 3) {
            matchEnded = true;
            finalWinner = "ai";
        } else if (roundsPlayed >= 5) {
            matchEnded = true;
            if (scores.human > scores.ai) finalWinner = "human";
            else if (scores.ai > scores.human) finalWinner = "ai";
            else finalWinner = "draw";
        }

        if (matchEnded) {
            isGameOver = true;
            clearInterval(timerInterval);
            
            const buttons = document.getElementsByClassName("game-btn");
            for(let btn of buttons) { btn.disabled = true; }
            document.getElementById("btn-pause").disabled = true;

            document.getElementById("status-astar").innerText = "Target Terminal Reached";
            document.getElementById("status-minimax").innerText = "Leaf evaluation terminal";
            document.getElementById("status-bfs").innerText = "Goal state evaluated";
            document.getElementById("status-chaining").innerText = "Chaining concluded";

            setTimeout(() => {
                const overlay = document.getElementById("end-screen");
                const title = document.getElementById("overlay-title");
                const msg = document.getElementById("overlay-msg");
                
                if (finalWinner === "human") {
                    title.innerText = "🏆 VICTORY 🏆";
                    title.style.color = "#00ff66";
                    msg.innerText = "Humanity prevails! Final Score: " + scores.human + "-" + scores.ai;
                } else if (finalWinner === "ai") {
                    title.innerText = "❌ DEFEAT ❌";
                    title.style.color = "#ff0055";
                    msg.innerText = "The AI network outmatched you. Final Score: " + scores.human + "-" + scores.ai;
                } else {
                    title.innerText = "🤝 STALEMATE 🤝";
                    title.style.color = "#ffb300";
                    msg.innerText = "An even match over 5 rounds! Score: " + scores.human + "-" + scores.ai;
                }
                overlay.style.display = "flex";
            }, 1500);

            return true;
        }
        return false;
    }

    async function resetMatch() {
        clearInterval(timerInterval);
        scores = { human: 0, ai: 0, ties: 0 };
        roundsPlayed = 0;
        prevOutcome = null;
        isGameOver = false;
        isPaused = false;
        
        const pauseBtn = document.getElementById("btn-pause");
        pauseBtn.innerText = "⏸️ Pause";
        pauseBtn.classList.remove("paused");
        pauseBtn.disabled = false;

        document.getElementById("end-screen").style.display = "none";
        const buttons = document.getElementsByClassName("game-btn");
        for(let btn of buttons) { btn.disabled = false; }
        
        document.getElementById("choices").innerText = "SYSTEM REBOOTED: Awaiting input...";
        document.getElementById("result").innerText = "";
        
        await fetch('/api/reset', { method: 'POST' });

        updateScoreboard();
        updateTelemetryDefaults();
        startTimer();
    }

    function capitalize(word) {
        return word.charAt(0).toUpperCase() + word.slice(1);
    }
</script>

</body>
</html>
"""

