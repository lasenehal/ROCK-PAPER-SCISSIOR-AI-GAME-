from flask import Flask, request, jsonify, render_template_string
import random

app = Flask(__name__)

# ---------------------------------------------------------
# BACKEND ENGINE STATE & LOGIC
# ---------------------------------------------------------

# Global memory model structure mapping tracking parameters across match instances
history_matrix = {
    "win": {"rock": 0, "paper": 0, "scissors": 0},
    "loss": {"rock": 0, "paper": 0, "scissors": 0},
    "tie": {"rock": 0, "paper": 0, "scissors": 0}
}

moves = ["rock", "paper", "scissors"]
counters = {"rock": "paper", "paper": "scissors", "scissors": "rock"}

@app.route('/api/predict', methods=['POST'])
def predict_move():
    global history_matrix
    data = request.get_json() or {}
    
    human_move = data.get("humanMove")
    prev_outcome = data.get("prevOutcome")
    
    # Update internal state history from the immediately completed baseline validation cycle
    if prev_outcome and human_move in moves:
        history_matrix[prev_outcome][human_move] += 1

    ai_move = "rock"
    bfs_telemetry = "H(n) Uniform -> Random Pick"
    
    # Process behavior algorithm chains if historical baseline records exist
    if prev_outcome and prev_outcome in history_matrix:
        predictions = history_matrix[prev_outcome]
        total_predictions = sum(predictions.values())
        
        if total_predictions > 0:
            # Pick highest recurring historical value node for tracking estimation path layouts
            predicted_human_move = max(predictions, key=predictions.get)
            
            if predictions[predicted_human_move] == 0:
                ai_move = random.choice(moves)
                bfs_telemetry = "H(n) Uniform -> Random Pick"
            else:
                ai_move = counters[predicted_human_move]
                bfs_telemetry = f"H(n) Highest -> Expect: {predicted_human_move.capitalize()}"
        else:
            ai_move = random.choice(moves)
    else:
        ai_move = random.choice(moves)

    return jsonify({
        "aiMove": ai_move,
        "telemetry": {
            "bfs": bfs_telemetry
        }
    })

@app.route('/api/reset', methods=['POST'])
def reset_history():
    global history_matrix
    history_matrix = {
        "win": {"rock": 0, "paper": 0, "scissors": 0},
        "loss": {"rock": 0, "paper": 0, "scissors": 0},
        "tie": {"rock": 0, "paper": 0, "scissors": 0}
    }
    return jsonify({"status": "History matrix flushed successfully"})


